{
  "manifest_version": 3,
  "name": "OpenBiliClaw",
  "version": "0.3.245",
  "description": "\u8de8\u5e73\u53f0\u5185\u5bb9\u53d1\u73b0 AI Agent \u2014 \u884c\u4e3a\u91c7\u96c6\u3001\u753b\u50cf\u4e0e\u667a\u80fd\u63a8\u8350",
  "permissions": [
    "activeTab",
    "alarms",
    "cookies",
    "notifications",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.xiaohongshu.com/*",
    "*://*.douyin.com/*",
    "*://*.youtube.com/*",
    "*://*.zhihu.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "js": [
        "dist/content/bilibili.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.xiaohongshu.com/*"
      ],
      "js": [
        "dist/content/xiaohongshu.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.xiaohongshu.com/*"
      ],
      "js": [
        "dist/main/xhs-token-sniffer.js",
        "dist/main/xhs-state-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "dist/content/douyin.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "dist/content/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.zhihu.com/*"
      ],
      "js": [
        "dist/content/zhihu.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "dist/content/x.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "dist/main/x-graphql-tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/main/dy-fetch-tap.js"
      ],
      "matches": [
        "*://*.douyin.com/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}