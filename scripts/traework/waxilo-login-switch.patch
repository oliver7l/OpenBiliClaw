+/// 把主客户端（TRAE SOLO CN）的登录切换到账号池里的某个账号。
+/// 会退出并重启客户端；切换前当前登录态自动回存档案。
+#[tauri::command]
+pub async fn switch_client_login(
+    app: tauri::AppHandle,
+    id: String,
+) -> Result<crate::login_switch::ClientLoginStatus, String> {
+    let dir = try_data_dir(&app)?;
+    tauri::async_runtime::spawn_blocking(move || {
+        let list = accounts::load_accounts(&dir);
+        let account = list
+            .into_iter()
+            .find(|a| a.id == id)
+            .ok_or_else(|| "账号不存在".to_string())?;
+        crate::login_switch::switch_login(&dir, &account)
+    })
+    .await
+    .map_err(|e| format!("切换任务异常：{e}"))?
+}
