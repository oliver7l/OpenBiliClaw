/* 乐仔相册 · 大图查看样式 */

.vp {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #000000;
  overflow: hidden;
}

.big {
  width: 100%;
  height: 100%;
  display: block;
}

.spin {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  text-align: center;
  color: #6b7280;
  font-size: 26rpx;
}

.topbar {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0));
  color: #e8eaed;
}

.label {
  font-size: 30rpx;
  font-weight: 600;
}

.pos {
  font-size: 26rpx;
  color: #9aa3af;
}

.bottombar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 48rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0));
}

.date {
  font-size: 26rpx;
  color: #c3c9d2;
}

.btn {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: #3b6fd4;
  color: #ffffff;
  font-size: 26rpx;
}
